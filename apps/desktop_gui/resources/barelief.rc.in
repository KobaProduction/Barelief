#include <windows.h>
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/barelief.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @BARELIEF_WINDOWS_VERSION@
 PRODUCTVERSION @BARELIEF_WINDOWS_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Koba Production\0"
   VALUE "FileDescription", "Barelief | Signal Processing & Visualization\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "InternalName", "core_app\0"
   VALUE "LegalCopyright", "Copyright (c) 2026 Koba Production\0"
   VALUE "OriginalFilename", "Barelief.exe\0"
   VALUE "ProductName", "Barelief\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
