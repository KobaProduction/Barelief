function(add_foundation_test test_name library)
    add_executable(${test_name} ${test_name}.cpp)
    target_link_libraries(${test_name} PRIVATE ${library})
    set_target_properties(${test_name} PROPERTIES AUTOMOC OFF CXX_STANDARD 20)
    if(MSVC)
        target_compile_options(${test_name} PRIVATE /UNDEBUG)
    else()
        target_compile_options(${test_name} PRIVATE -UNDEBUG)
    endif()
    add_test(NAME ${test_name} COMMAND ${test_name})
    set_tests_properties(${test_name} PROPERTIES LABELS "portable;quick" TIMEOUT 15)
endfunction()
