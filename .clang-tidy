Checks: '-*,readability-function-size,readability-function-cognitive-complexity'
WarningsAsErrors: '*'
CheckOptions:
  readability-function-size.StatementThreshold: '20'
  readability-function-size.IgnoreMacros: 'false'
  readability-function-cognitive-complexity.Threshold: '15'
  readability-function-cognitive-complexity.IgnoreMacros: 'false'
