cmake-*-*
/CMakeUserPresets.json

# Independent local build trees used for architecture validation.
/build-editor/
/build-gui/
/build-network/
/build-pipeline-owner/
/build-adapter-slice/
/build-sdk*/
/build-qt-slice/
/review-desktop-platform/
/review-qt-presentation/
/review-dataflow-runtime/
/review-embedded-sdk/
/review-desktop-analysis/
/build-desktop-integration/
/build-headless-verify/
/review-desktop-application/
/build-fixture-audit/
/review-test-fixtures/
/review-qt-integration/
/review-final-architecture/
/review-final-runtime/
/review-final-desktop/
/review-gui-port-repair/
/scripts/__pycache__/
/build-*/

# Local generated caches, build evidence and configuration backups.
__pycache__/
*.pyc
/build-refactor-delivery-configure.log
/config.pre-numeric.json
/output/*.exe

# Temporary agent notes and evidence; durable work is tracked in GitHub issues.
/.agent-workspace/

# Local Serena language-server state and generated compilation database.
/.serena/
/compile_commands.json
/.cache/clangd/

# ESP-IDF examples: generated target-specific configuration and component resolution.
# Keep sdkconfig.defaults in version control; regenerate the files below as needed.
/examples/**/sdkconfig
/examples/**/sdkconfig.old
/examples/**/dependencies.lock
