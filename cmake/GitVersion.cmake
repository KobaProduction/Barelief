find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/scripts/git_version.py"
    --source "${CMAKE_CURRENT_SOURCE_DIR}"
    OUTPUT_VARIABLE git_version_json ERROR_VARIABLE git_version_error RESULT_VARIABLE git_version_result)
if(NOT git_version_result EQUAL 0)
    message(FATAL_ERROR "${git_version_error}")
endif()
foreach(field IN ITEMS version displayVersion build commit packageSuffix)
    string(JSON git_${field} GET "${git_version_json}" identity ${field})
endforeach()
set(BARELIEF_VERSION "${git_version}")
set(BARELIEF_DISPLAY_VERSION "${git_displayVersion}")
set(BARELIEF_BUILD_ID "${git_build}")
set(BARELIEF_COMMIT "${git_commit}")
set(BARELIEF_PACKAGE_SUFFIX "${git_packageSuffix}")
string(JSON BARELIEF_IDENTITY_JSON GET "${git_version_json}" identity)
file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/build-identity.json" CONTENT "${BARELIEF_IDENTITY_JSON}\n" @ONLY)
string(JSON input_count LENGTH "${git_version_json}" inputs)
math(EXPR last_input "${input_count} - 1")
foreach(index RANGE 0 ${last_input})
    string(JSON input GET "${git_version_json}" inputs ${index})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
endforeach()
string(JSON directory_count LENGTH "${git_version_json}" gitDirectories)
math(EXPR last_directory "${directory_count} - 1")
foreach(index RANGE 0 ${last_directory})
    string(JSON directory GET "${git_version_json}" gitDirectories ${index})
    if(index EQUAL 0)
        file(GLOB version_git_inputs CONFIGURE_DEPENDS "${directory}/packed-refs")
    else()
        file(GLOB_RECURSE version_git_inputs CONFIGURE_DEPENDS "${directory}/*")
    endif()
endforeach()
file(GLOB version_root_inputs CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/*")
foreach(root adapters application apps cmake docs domain examples libs packaging presentation scripts tests tools .github)
    file(GLOB_RECURSE version_inputs CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/${root}/*")
endforeach()
message(STATUS "Git version: ${BARELIEF_DISPLAY_VERSION}; build: ${BARELIEF_BUILD_ID}")
