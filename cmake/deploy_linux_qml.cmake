# Preserve the existing embedded QML resources; scan only their external imports.
# Linux's generic Qt deploy tool does not interpret windeployqt --qmldir options.
function(barelief_linux_install_rpath target)
    file(RELATIVE_PATH lib_from_bin "/${CMAKE_INSTALL_BINDIR}" "/${CMAKE_INSTALL_LIBDIR}")
    set_property(TARGET ${target} PROPERTY INSTALL_RPATH "$ORIGIN/${lib_from_bin}")
endfunction()

function(barelief_generate_linux_qml_deploy_script target output_script)
    find_program(BARELIEF_PATCHELF_EXECUTABLE NAMES patchelf REQUIRED)
    set(qml_root "${PROJECT_SOURCE_DIR}/presentation/qt/qml")
    set(content [==[
# Required imports in the payload must never be forgiven by an optional qmldir edge.
function(barelief_collect_required_qml_imports directory output)
    set(required)
    file(GLOB payload LIST_DIRECTORIES TRUE "${directory}/*")
    foreach(item IN LISTS payload)
        if(IS_DIRECTORY "${item}")
            if(NOT EXISTS "${item}/qmldir")
                barelief_collect_required_qml_imports("${item}" nested)
                list(APPEND required ${nested})
            endif()
        elseif(item MATCHES "\\.(qml|js)$")
            file(STRINGS "${item}" lines REGEX "^[ \t]*\\.?import[ \t]+[A-Za-z_]")
            foreach(line IN LISTS lines)
                if(line MATCHES "^[ \t]*\\.?import[ \t]+([A-Za-z_][A-Za-z_0-9.]*)")
                    list(APPEND required "${CMAKE_MATCH_1}")
                endif()
            endforeach()
        endif()
    endforeach()
    list(REMOVE_DUPLICATES required)
    set(${output} "${required}" PARENT_SCOPE)
endfunction()
execute_process(COMMAND "$<TARGET_FILE:Qt6::qtpaths>" --query QT_INSTALL_QML
    OUTPUT_VARIABLE qt_qml_dir OUTPUT_STRIP_TRAILING_WHITESPACE
    COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "$<TARGET_FILE:Qt6::qmlimportscanner>"
    -rootPath "@qml_root@" -importPath "${qt_qml_dir}"
    OUTPUT_VARIABLE imports COMMAND_ERROR_IS_FATAL ANY)
string(JSON count LENGTH "${imports}")
if(count EQUAL 0)
    message(FATAL_ERROR "The application QML import scan returned no imports")
endif()
math(EXPR last "${count} - 1")
# The scanner reports optional platform styles even when no implementation ships
# on this target. Prove optionality from the resolved modules' qmldir metadata.
barelief_collect_required_qml_imports("@qml_root@" required_imports)
set(optional_imports)
foreach(index RANGE 0 ${last})
    string(JSON type GET "${imports}" ${index} type)
    string(JSON source ERROR_VARIABLE no_source GET "${imports}" ${index} path)
    if(NOT type STREQUAL "module" OR no_source OR source STREQUAL "")
        continue()
    endif()
    file(RELATIVE_PATH relative "${qt_qml_dir}" "${source}")
    if(relative MATCHES "^\\.\\.(/|$)" OR IS_ABSOLUTE "${relative}")
        message(FATAL_ERROR "QML module is outside the configured Qt import tree: ${source}")
    endif()
    barelief_collect_required_qml_imports("${source}" required_payload_imports)
    list(APPEND required_imports ${required_payload_imports})
    if(NOT EXISTS "${source}/qmldir")
        continue()
    endif()
    file(STRINGS "${source}/qmldir" declarations
        REGEX "^[ \t]*((optional|default)[ \t]+)?(import|depends)[ \t]+")
    foreach(declaration IN LISTS declarations)
        if(declaration MATCHES "^[ \t]*optional[ \t]+import[ \t]+([A-Za-z_][A-Za-z_0-9.]*)")
            list(APPEND optional_imports "${CMAKE_MATCH_1}")
        elseif(declaration MATCHES "^[ \t]*(default[ \t]+)?(import|depends)[ \t]+([A-Za-z_][A-Za-z_0-9.]*)")
            list(APPEND required_imports "${CMAKE_MATCH_3}")
        endif()
    endforeach()
endforeach()
list(REMOVE_DUPLICATES optional_imports)
list(REMOVE_DUPLICATES required_imports)
set(original_plugins)
set(installed_plugins)
set(installed_modules)
foreach(index RANGE 0 ${last})
    string(JSON type GET "${imports}" ${index} type)
    if(NOT type STREQUAL "module")
        continue()
    endif()
    string(JSON name GET "${imports}" ${index} name)
    string(JSON source ERROR_VARIABLE no_source GET "${imports}" ${index} path)
    if(no_source OR source STREQUAL "")
        # These application modules are registered by C++, not filesystem plugins.
        if(name STREQUAL "Barelief.Surface" OR name STREQUAL "Numeric.Graphs")
            continue()
        endif()
        if(name IN_LIST optional_imports AND NOT name IN_LIST required_imports)
            message(STATUS "Skipping unavailable optional QML module: ${name}")
            continue()
        endif()
        message(FATAL_ERROR "Unresolved QML module in application deployment: ${name}")
    endif()
    file(RELATIVE_PATH relative "${qt_qml_dir}" "${source}")
    if(relative MATCHES "^\\.\\.(/|$)" OR IS_ABSOLUTE "${relative}")
        message(FATAL_ERROR "QML module is outside the configured Qt import tree: ${source}")
    endif()
    if(relative IN_LIST installed_modules)
        continue()
    endif()
    list(APPEND installed_modules "${relative}")
    set(destination "${CMAKE_INSTALL_PREFIX}/${QT_DEPLOY_QML_DIR}/${relative}")
    file(GLOB payload LIST_DIRECTORIES TRUE "${source}/*")
    foreach(item IN LISTS payload)
        if(IS_DIRECTORY "${item}")
            # A child module has a separate scanner entry and dependency closure.
            if(NOT EXISTS "${item}/qmldir")
                file(INSTALL "${item}" DESTINATION "${destination}" TYPE DIRECTORY
                    USE_SOURCE_PERMISSIONS)
            endif()
        else()
            file(INSTALL "${item}" DESTINATION "${destination}" TYPE FILE
                USE_SOURCE_PERMISSIONS)
        endif()
    endforeach()
    file(GLOB plugins LIST_DIRECTORIES FALSE "${source}/*.so" "${source}/*.so.*")
    foreach(plugin IN LISTS plugins)
        list(APPEND original_plugins "${plugin}")
        get_filename_component(plugin_name "${plugin}" NAME)
        list(APPEND installed_plugins
            "${QT_DEPLOY_PREFIX}/${QT_DEPLOY_QML_DIR}/${relative}/${plugin_name}")
    endforeach()
endforeach()
list(REMOVE_DUPLICATES original_plugins)
# Scan original Qt plugin files while their SDK RPATHs can resolve every dependency.
qt_deploy_runtime_dependencies(
    EXECUTABLE "$<TARGET_FILE:@target@>"
    ADDITIONAL_MODULES ${original_plugins}
    INCLUDE_PLUGINS qoffscreen
    GENERATE_QT_CONF)
set(patched_plugins)
foreach(plugin IN LISTS installed_plugins)
    file(REAL_PATH "${plugin}" real_plugin)
    if(real_plugin IN_LIST patched_plugins)
        continue()
    endif()
    list(APPEND patched_plugins "${real_plugin}")
    get_filename_component(plugin_dir "${real_plugin}" DIRECTORY)
    file(RELATIVE_PATH lib_from_plugin "${plugin_dir}" "${QT_DEPLOY_PREFIX}/${QT_DEPLOY_LIB_DIR}")
    execute_process(COMMAND "@BARELIEF_PATCHELF_EXECUTABLE@"
        --set-rpath "$ORIGIN/${lib_from_plugin}" "${real_plugin}"
        COMMAND_ERROR_IS_FATAL ANY)
endforeach()
]==])
    string(CONFIGURE "${content}" content @ONLY)
