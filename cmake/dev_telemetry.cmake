target_compile_definitions(runtime_performance INTERFACE
    BARELIEF_DEV_TELEMETRY=$<BOOL:${BARELIEF_DEV_TELEMETRY}>)
if(NOT BARELIEF_DEV_TELEMETRY)
    return()
endif()

include(FetchContent)
set(TRACY_ENABLE ON CACHE BOOL "" FORCE)
set(TRACY_STATIC ON CACHE BOOL "" FORCE)
set(TRACY_ON_DEMAND ON CACHE BOOL "" FORCE)
set(TRACY_ONLY_LOCALHOST ON CACHE BOOL "" FORCE)
set(TRACY_NO_BROADCAST ON CACHE BOOL "" FORCE)
set(TRACY_MANUAL_LIFETIME ON CACHE BOOL "" FORCE)
set(TRACY_NO_FRAME_IMAGE ON CACHE BOOL "" FORCE)
FetchContent_Declare(tracy
    URL https://github.com/wolfpld/tracy/archive/refs/tags/v0.14.1.tar.gz
    URL_HASH SHA256=bf4af567e9c7524d07f3caa745fad02fb33bd5694f11910750382d1efbb251c1
    EXCLUDE_FROM_ALL)
FetchContent_MakeAvailable(tracy)
target_compile_definitions(TracyClient PUBLIC TRACY_DELAYED_INIT TRACY_SAMPLING_PROFILER_MANUAL_START)
if(MINGW)
    # MinGW 13 frees emulated TLS before running C++ TLS destructors. Reuse
    # Tracy's existing pthread-key fallback instead of a nontrivial TLS object.
    set(tracy_profiler_source "${tracy_SOURCE_DIR}/public/client/TracyProfiler.cpp")
    file(READ "${tracy_profiler_source}" tracy_profiler_code)
    set(tracy_tls_guard "#if !defined(__clang__) && defined(__GNUC__) && ((__GNUC__ < 8) || ((__GNUC__ == 8) && (__GNUC_MINOR__ < 4)))")
    set(tracy_mingw_tls_guard "${tracy_tls_guard} || defined(__MINGW32__) // Barelief TLS compatibility")
    if(NOT tracy_profiler_code MATCHES "Barelief TLS compatibility")
        string(FIND "${tracy_profiler_code}" "${tracy_tls_guard}" tracy_tls_offset)
        if(tracy_tls_offset EQUAL -1)
            message(FATAL_ERROR "Tracy TLS compatibility patch no longer matches; review the pinned version")
        endif()
        string(REPLACE "${tracy_tls_guard}" "${tracy_mingw_tls_guard}" tracy_profiler_code "${tracy_profiler_code}")
        file(WRITE "${tracy_profiler_source}" "${tracy_profiler_code}")
    endif()
    target_include_directories(TracyClient PRIVATE ${CMAKE_SOURCE_DIR}/adapters/desktop/include)
    target_compile_definitions(TracyClient PRIVATE TRACY_PLATFORM_HEADER="core/tracy_platform.h")
endif()
set_target_properties(TracyClient PROPERTIES AUTOMOC OFF)
add_library(desktop_telemetry STATIC ${CMAKE_SOURCE_DIR}/adapters/desktop/src/telemetry.cpp)
target_include_directories(desktop_telemetry PUBLIC ${CMAKE_SOURCE_DIR}/adapters/desktop/include)
target_compile_definitions(desktop_telemetry PUBLIC BARELIEF_DEV_TELEMETRY=1)
target_link_libraries(desktop_telemetry PUBLIC Tracy::TracyClient)
target_link_libraries(runtime_performance INTERFACE desktop_telemetry)
