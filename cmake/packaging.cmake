# Shared product metadata for portable archives and an optional Windows installer.
set(CPACK_PACKAGE_NAME "Barelief")
set(CPACK_PACKAGE_VENDOR "Koba Production")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Barelief | Signal Processing & Visualization")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://github.com/KobaProduction/Barelief")
set(CPACK_PACKAGE_CONTACT "https://github.com/KobaProduction/Barelief/issues")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "Koba Production/Barelief")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGE_FILE_NAME "Barelief-${PROJECT_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}")
set(CPACK_PACKAGE_EXECUTABLES "Barelief" "Barelief")
set(CPACK_VERBATIM_VARIABLES YES)
# Desktop distributions are installed as one application, not SDK components.
set(CPACK_MONOLITHIC_INSTALL ON)
set(CPACK_GENERATOR "ZIP")
if(WIN32 AND BUILD_GUI)
    set(CPACK_GENERATOR "ZIP;NSIS")
    set(CPACK_NSIS_DISPLAY_NAME "Barelief")
    set(CPACK_NSIS_PACKAGE_NAME "Barelief")
    set(CPACK_NSIS_MUI_ICON "${PROJECT_SOURCE_DIR}/apps/desktop_gui/resources/barelief.ico")
    set(CPACK_NSIS_MUI_UNIICON "${CPACK_NSIS_MUI_ICON}")
    set(CPACK_NSIS_EXECUTABLES_DIRECTORY "bin")
    set(CPACK_NSIS_INSTALLED_ICON_NAME "bin\\Barelief.exe")
    set(CPACK_NSIS_MODIFY_PATH OFF)
    set(CPACK_NSIS_COMPRESSOR "zlib")
    set(CPACK_NSIS_ENABLE_UNINSTALL_BEFORE_INSTALL ON)
endif()
install(FILES "${PROJECT_SOURCE_DIR}/LICENSE" "${PROJECT_SOURCE_DIR}/THIRD_PARTY_NOTICES.md" DESTINATION .)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/packaging/licenses/" DESTINATION licenses)
include(CPack)
