find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/scripts/project_environment.py"
    --source "${CMAKE_CURRENT_SOURCE_DIR}"
    OUTPUT_VARIABLE project_environment ERROR_VARIABLE project_environment_error RESULT_VARIABLE project_environment_result)
if(NOT project_environment_result EQUAL 0)
    message(FATAL_ERROR "${project_environment_error}")
endif()
string(JSON project_environment_count LENGTH "${project_environment}")
if(project_environment_count GREATER 0)
    math(EXPR project_environment_last "${project_environment_count} - 1")
    foreach(index RANGE 0 ${project_environment_last})
        string(JSON key MEMBER "${project_environment}" ${index})
        string(JSON value GET "${project_environment}" "${key}")
        set(ENV{${key}} "${value}")
    endforeach()
endif()
if(NOT CMAKE_PREFIX_PATH AND DEFINED ENV{QT_ROOT})
    set(CMAKE_PREFIX_PATH "$ENV{QT_ROOT}")
endif()
if(NOT CMAKE_MAKE_PROGRAM AND DEFINED ENV{NINJA_EXE})
    set(CMAKE_MAKE_PROGRAM "$ENV{NINJA_EXE}" CACHE FILEPATH "Project-local Ninja")
endif()
if(CMAKE_HOST_WIN32 AND DEFINED ENV{CXX})
    get_filename_component(project_compiler_bin "$ENV{CXX}" DIRECTORY)
    file(TO_CMAKE_PATH "${project_compiler_bin}" project_compiler_bin)
    set(ENV{PATH} "${project_compiler_bin};$ENV{PATH}")
    # A later build starts in a new process. Keep a stable launcher in its
    # rules; it loads current tool paths without baking a terminal's PATH in.
    set(project_compiler_environment "\"${Python3_EXECUTABLE}\" \"${CMAKE_CURRENT_LIST_DIR}/../scripts/run_project_tool.py\" --source \"${CMAKE_CURRENT_SOURCE_DIR}\" --")
    set_property(DIRECTORY PROPERTY RULE_LAUNCH_COMPILE "${project_compiler_environment}")
    set_property(DIRECTORY PROPERTY RULE_LAUNCH_LINK "${project_compiler_environment}")
    set_property(DIRECTORY PROPERTY RULE_LAUNCH_CUSTOM "${project_compiler_environment}")
endif()
file(GLOB project_environment_local CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/.env.local")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_CURRENT_SOURCE_DIR}/scripts/project_environment.py" ${project_environment_local})
