function(portable_esp32_preflight)
    if(NOT PORTABLE_SDK_MAX_FFT_SIZE MATCHES "^(512|1024|2048|4096)$")
        message(FATAL_ERROR "FFT capacity must be 512, 1024, 2048 or 4096")
    endif()
    if(ESP32_TOOLCHAIN_DIR)
        if(NOT IS_DIRECTORY "${ESP32_TOOLCHAIN_DIR}/bin")
            message(FATAL_ERROR "ESP32_TOOLCHAIN_DIR must contain a bin directory")
        endif()
        if(WIN32)
            set(ENV{PATH} "${ESP32_TOOLCHAIN_DIR}/bin;$ENV{PATH}")
        else()
            set(ENV{PATH} "${ESP32_TOOLCHAIN_DIR}/bin:$ENV{PATH}")
        endif()
    endif()
    find_program(esp32_cc NAMES xtensa-esp-elf-gcc xtensa-esp32-elf-gcc NO_CACHE)
    find_program(esp32_cxx NAMES xtensa-esp-elf-g++ xtensa-esp32-elf-g++ NO_CACHE)
    if(NOT esp32_cc OR NOT esp32_cxx)
        message(FATAL_ERROR "ESP32 cross compiler is unavailable. Set ESP32_TOOLCHAIN_DIR or activate an existing ESP-IDF export environment. No compiler or platform is installed by this build.")
    endif()
endfunction()
